# ===== 应用配置 =====
APP_NAME=Interview Copilot
APP_ENV=production
DEBUG=false

# ===== 数据库 =====
# 开发用 SQLite，部署可以继续用 SQLite（Render 持久化磁盘）
DATABASE_URL=sqlite+aiosqlite:///./data/interview.db
# 如果用 PostgreSQL，取消下面这行注释并修改连接串
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/interview_copilot

# ===== Redis（可选，不填用内存缓存）=====
# REDIS_URL=redis://localhost:6379

# ===== JWT（生产环境必须改成强随机密钥！）=====
JWT_SECRET=请改成一个至少32位的随机字符串，例如用 openssl rand -hex 32 生成
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ===== CORS（前端部署后的域名，多个用逗号分隔）=====
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174

# ===== LLM API（至少配置一个）=====
DEEPSEEK_API_KEY=你的DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ===== 向量库（Chroma 本地文件）=====
CHROMA_PERSIST_DIR=./data/chroma
